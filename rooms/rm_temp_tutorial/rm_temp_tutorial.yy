    {"$GMRAssetLayer":"","%Name":"Decals","assets":[
        {"$GMRTextItem":"v3","%Name":"text_57420CD2","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"tempFont","path":"fonts/tempFont/tempFont.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_57420CD2","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":2.0,"scaleY":2.0,"text":"Use A and D to walk","wrap":false,"x":96.0,"y":1344.0,},
        {"$GMRTextItem":"v3","%Name":"text_32152C0D","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"tempFont","path":"fonts/tempFont/tempFont.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_32152C0D","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":2.0,"scaleY":2.0,"text":"Press W or Space to jump","wrap":false,"x":480.0,"y":1248.0,},
