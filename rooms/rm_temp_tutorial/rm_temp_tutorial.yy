        {"$GMRTextItem":"v3","%Name":"text_6355F002","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"tempFont","path":"fonts/tempFont/tempFont.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_6355F002","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":2.0,"scaleY":2.0,"text":"Press RMB to use the shotgun\r\nYou can parry stuff with the shotgun\r\nParry my bullets","wrap":false,"x":2048.0,"y":256.0,},
        {"$GMRTextItem":"v3","%Name":"text_461914F8","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"tempFont","path":"fonts/tempFont/tempFont.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_461914F8","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":2.0,"scaleY":2.0,"text":"You can use Q and E to switch weapons\r\nYou can also use number keys\r\n1 - revolver\r\n2 - grenade launcher\r\n3 - energy rifle\r\n4 - railcannon (requires charge (bottom left))","wrap":false,"x":2240.0,"y":672.0,},
