grav = 0
gravIntensity = 0.5
gravLimit = 25

// macros are constants
#macro cayoteFrameLimit 10
cayoteFrames = cayoteFrameLimit

walkSpeed = 5
sprintSpeed = 12

canMove = true
isSlamming = false
isDiving = false

xVelocity = 0

solids = [obj_solid_hitbox]
hurtboxes = [obj_hurtbox]

keybinds = {left : [ord("A")],
			right : [ord("D")],
			jump : [vk_space],
			sprint : [vk_shift],
			slam : [ord("S")]}